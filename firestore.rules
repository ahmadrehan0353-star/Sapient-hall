rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function roleDoc() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    function hasRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasRole() && roleDoc().data.role == 'admin';
    }
    function isEditor() {
      return hasRole() && (roleDoc().data.role == 'admin' || roleDoc().data.role == 'editor');
    }

    // ---- Public-facing content: editors manage, anyone may read ----
    match /news/{id}          { allow read: if true; allow write: if isEditor(); }
    match /events/{id}        { allow read: if true; allow write: if isEditor(); }
    match /gallery/{id}       { allow read: if true; allow write: if isEditor(); }
    match /testimonials/{id}  { allow read: if true; allow write: if isEditor(); }
    match /faqs/{id}          { allow read: if true; allow write: if isEditor(); }
    match /announcements/{id} { allow read: if true; allow write: if isEditor(); }
    match /staff/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}      { allow read: if true; allow write: if isAdmin(); }

    // ---- Form submissions: public may create, only admins may read/manage ----
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /newsletter_subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Role documents: readable by their owner, managed by admins ----
    match /admin_users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
